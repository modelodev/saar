{
  "schema_version": "saar.profile/1.0",
  "meta": {
    "id": "echo_cli",
    "lifecycle": "transient",
    "description": "Echo CLI for testing"
  },
  "parameters": {
    "delay_ms": {"source": "fixed", "value": 100, "type": "int"}
  },
  "runner": {
    "type": "echo_cli",
    "tool_config": {"script": "echo_cli.py"}
  },
  "interface": {
    "protocol": "runner",
    "capabilities": {
      "echo": {"input_schema": "std:chat", "streaming": false, "limits": {"call_timeout_ms": 50}}
    }
  }
}
