{
  "meta": {
    "id": "inbox-assist-new",
    "lifecycle": "continuous",
    "description": "Conversation assistant for your mailbox"
  },
  "parameters": {
    "openrouter_model": { "source": "config", "key": "model", "type": "string" },
    "openrouter_api_key": { "source": "secret", "key": "openrouter_api_key", "type": "string" },
    "client_id": { "source": "secret", "key": "outlook_client_id", "type": "string" },
    "client_secret": { "source": "secret", "key": "outlook_client_secret", "type": "string" },
    "tenant_id": { "source": "config", "key": "outlook_tenant_id", "type": "string" },
    "stream_response": { "source": "fixed", "value": "false", "type": "string" },
    "api_security_token": { "source": "fixed", "value": "eqhkecnlkjql", "type": "string" },
    "api_host": { "source": "fixed", "value": "127.0.0.1", "type": "string" },
    "user_email": { "source": "init", "key": "user_email", "type": "string" }
  },
  "runner": {
    "type": "generic_uvx_server",
    "tool_config": {
      "package": "inbox-assist-new",
      "command": "inbox-assist-new"
    },
    "runtime": {
      "mode": "managed_port",
      "port_env_var": "API_PORT",
      "host_env_var": "API_HOST"
    },
    "env_map": {
      "OPENROUTER_MODEL": "{{params.openrouter_model}}",
      "OPENROUTER_API_KEY": "{{params.openrouter_api_key}}",
      "CLIENT_ID": "{{params.client_id}}",
      "CLIENT_SECRET": "{{params.client_secret}}",
      "TENANT_ID": "{{params.tenant_id}}",
      "STREAM_RESPONSE": "{{params.stream_response}}",
      "API_SECURITY_TOKEN": "{{params.api_security_token}}",
      "API_HOST": "{{params.api_host}}",
      "USER_EMAIL": "{{params.user_email}}"
    }
  },
  "interface": {
    "protocol": "http",
    "base_url": "http://{{runner.host}}:{{runner.port}}",
    "headers": {
      "Authorization": "Bearer {{params.api_security_token}}"
    },
    "health_check": {
      "path": "/api/v1/status",
      "method": "GET",
      "expect_statuses": [200]
    },
    "capabilities": {
      "chat": {
        "path": "/api/v1/chat",
        "method": "POST",
        "input_schema": { "$ref": "std:chat" },
        "body": {
          "type": "json",
          "template": {
            "messages": { "$from": "/input/messages" },
            "context": { "$from": "/context" }
          }
        },
        "response": {
          "text_pointer": "/response"
        }
      },
      "files": {
        "path": "/api/v1/attachments/",
        "method": "POST",
        "input_schema": { "$ref": "std:files" },
        "body": {
          "type": "json",
          "template": {
            "file_url": { "$from": "/input/files/0/url" },
            "original_filename": { "$from": "/input/files/0/name" },
            "mime_type": { "$from": "/input/files/0/mime" },
            "instruction": { "$from": "/input/files/0/context" }
          }
        },
        "response": {
          "text_pointer": "/response"
        }
      }
    }
  }
}
