{
  "meta": {
    "id": "gpt-researcher",
    "lifecycle": "transient",
    "description": "GPT-Researcher, a web researcher agent."
  },
  "parameters": {
    "tavily_api_key": { "source": "secret", "key": "tavily_api_key", "type": "string" },
    "openai_api_key": { "source": "secret", "key": "openai_api_key", "type": "string" }
  },
  "runner": {
    "type": "generic_uvx",
    "tool_config": {
      "package": "gpt-researcher",
      "command": "gpt-researcher"
    },
    "env_map": {
      "TAVILY_API_KEY": "{{params.tavily_api_key}}",
      "OPENAI_API_KEY": "{{params.openai_api_key}}"
    },
    "args": [
      "{{helpers.last_user_content}}",
      "--report_type",
      "{{input.report_type}}",
      "--tone",
      "{{input.tone}}"
    ]
  },
  "interface": {
    "protocol": "runner",
    "capabilities": {
      "chat": {
        "input_schema": {
          "base": "std:chat",
          "extra_fields": {
            "report_type": {
              "type": "string",
              "enum": [
                "research_report", "resource_report", "outline_report",
                "custom_report", "detailed_report", "subtopic_report"
              ],
              "default": "detailed_report"
            },
            "tone": {
              "type": "string",
              "enum": [
                "objective", "formal", "analytical", "persuasive",
                "informative", "explanatory", "descriptive", "critical",
                "comparative", "speculative", "reflective", "narrative",
                "humorous", "optimistic", "pessimistic"
              ],
              "default": "objective"
            }
          }
        }
      }
    }
  }
}
