{
  "meta": {
    "id": "lightrag",
    "lifecycle": "continuous",
    "description": "LightRAG: Document-based RAG queries (vNext: explicit files semantics)"
  },
  "parameters": {
    "llm_binding": { "source": "fixed", "value": "openai", "type": "string" },
    "embedding_binding": { "source": "fixed", "value": "openai", "type": "string" },
    "embedding_dim": { "source": "fixed", "value": 3072, "type": "int" },

    "embedding_binding_api_key": { "source": "secret", "key": "gemini_api_key", "type": "string" },
    "embedding_binding_host": { "source": "config", "key": "gemini_url", "type": "string" },

    "llm_binding_api_key": { "source": "secret", "key": "openrouter_api_key", "type": "string" },
    "llm_binding_host": { "source": "config", "key": "openrouter_url", "type": "string" },
    "llm_model": { "source": "config", "key": "model", "type": "string" },
    "embedding_model": { "source": "config", "key": "embedding_model", "type": "string" },

    "lightrag_api_key": { "source": "secret", "key": "lightrag_api_key", "type": "string" },
    "name": { "source": "fixed", "value": "lightrag", "type": "string" }
  },
  "runner": {
    "type": "generic_uvx_server",
    "tool_config": {
      "package": "lightrag-hku[api]",
      "command": "lightrag-server",
      "with_packages": [
        "ollama",
        "pip",
        "nano_vectordb",
        "fastapi",
        "uvicorn",
        "jwt",
        "aiofiles",
        "python_multipart"
      ]
    },
    "runtime": {
      "mode": "managed_port",
      "port_env_var": "PORT",
      "host_env_var": "HOST"
    },
    "env_map": {
      "LLM_BINDING": "{{params.llm_binding}}",
      "EMBEDDING_BINDING": "{{params.embedding_binding}}",
      "EMBEDDING_DIM": "{{params.embedding_dim}}",
      "NAME": "{{params.name}}",

      "EMBEDDING_BINDING_API_KEY": "{{params.embedding_binding_api_key}}",
      "EMBEDDING_BINDING_HOST": "{{params.embedding_binding_host}}",

      "LLM_BINDING_API_KEY": "{{params.llm_binding_api_key}}",
      "LLM_BINDING_HOST": "{{params.llm_binding_host}}",
      "LLM_MODEL": "{{params.llm_model}}",
      "EMBEDDING_MODEL": "{{params.embedding_model}}",

      "LIGHTRAG_API_KEY": "{{params.lightrag_api_key}}"
    }
  },
  "interface": {
    "protocol": "http",
    "base_url": "http://{{runner.host}}:{{runner.port}}",
    "headers": {
      "X-API-Key": "{{params.lightrag_api_key}}"
    },
    "health_check": {
      "path": "/health",
      "method": "GET",
      "expect_statuses": [200]
    },
    "capabilities": {
      "chat": {
        "response_mode": "sync",
        "streaming": false,
        "input_schema": {
          "base": "std:chat",
          "extra_fields": {
            "mode": {
              "type": "string",
              "enum": ["hybrid", "naive", "local", "global", "mix"],
              "default": "hybrid"
            }
          }
        },
        "path": "/query",
        "method": "POST",
        "body": {
          "type": "json",
          "template": {
            "query": "{{helpers.last_user_content}}",
            "mode": { "$from": "/input/mode" },
            "top_k": 5,
            "history_turns": 5
          }
        },
        "response": {
          "text_pointer": "/response"
        },
        "files": {
          "accepts": false,
          "max_files": 0
        }
      },
      "files": {
        "response_mode": "sync",
        "streaming": false,
        "input_schema": "std:files",

        "path": "/upload",
        "method": "POST",
        "body": {
          "type": "multipart",
          "fields": {},
          "files": [{ "field": "file", "source_pointer": "/input/files/0" }]
        },
        "response": {
          "text_pointer": "/message",
          "capture": {
            "track_id": "/track_id"
          }
        },
        "files": {
          "accepts": true,
          "max_files": 1,
          "ingest_effect": "eventual"
        }
      }
    }
  }
}
