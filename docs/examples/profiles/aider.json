{
  "meta": {
    "id": "aider",
    "lifecycle": "transient",
    "description": "Aider, AI coding companion in your local repository."
  },
  "parameters": {
    "openrouter_api_key": { "source": "secret", "key": "openrouter_api_key", "type": "string" },
    "model": { "source": "config", "key": "model", "type": "string" },
    "aider_yes_always": { "source": "fixed", "value": "true", "type": "string" },
    "aider_auto_commit": { "source": "fixed", "value": "false", "type": "string" },
    "aider_git": { "source": "fixed", "value": "false", "type": "string" },
    "aider_pretty": { "source": "fixed", "value": "false", "type": "string" },
    "aider_analytics": { "source": "fixed", "value": "false", "type": "string" },
    "aider_restore_chat_history": { "source": "fixed", "value": "false", "type": "string" },
    "aider_show_model_warnings": { "source": "fixed", "value": "false", "type": "string" },
    "aider_detect_urls": { "source": "fixed", "value": "false", "type": "string" },
    "aider_auto_lint": { "source": "fixed", "value": "false", "type": "string" },
    "aider_auto_test": { "source": "fixed", "value": "false", "type": "string" },
    "aider_check_update": { "source": "fixed", "value": "false", "type": "string" }
  },
  "runner": {
    "type": "generic_uvx_unified",
    "mode": "auto",
    "tool_config": {
      "package": "aider-chat",
      "command": "aider",
      "python": "3.12"
    },
    "env_map": {
      "PYO3_USE_ABI3_FORWARD_COMPATIBILITY": "1",
      "OPENROUTER_API_KEY": "{{params.openrouter_api_key}}",
      "AIDER_MODEL": "openrouter/{{params.model}}"
    },
    "args": [
      "--yes-always",
      "--no-pretty",
      "--no-analytics",
      "--no-show-model-warnings",
      "--no-detect-urls",
      "--no-auto-test",
      "--no-check-update",
      "--no-git",
      "--no-gitignore",
      "--model",
      "openrouter/{{params.model}}",
      "--api-key",
      "openrouter={{params.openrouter_api_key}}",
      "--input-history-file",
      ".aider.input.history",
      "--chat-history-file",
      ".aider.chat.history.md",
      "--llm-history-file",
      ".aider.llm.history.json",
      "--message",
      "{{helpers.last_user_content}}"
    ],
    "artifact_config": {
      "include": ["**/*"],
      "exclude": [".aider*", ".aider*/**", ".git/**", "**/__pycache__/**"]
    }
  },
  "interface": {
    "protocol": "runner",
    "capabilities": {
      "chat": {
        "input_schema": { "$ref": "std:chat" },
        "response_mode": "sync",
        "streaming": false
      }
    }
  }
}
